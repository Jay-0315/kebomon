generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CurrencyCode {
  KRW
  JPY
}

enum AuthProvider {
  GOOGLE
}

/**
 * 가챠/알까기 확률·천장 설정 (싱글턴, id는 항상 1) — 관리자 페이지에서 편집.
 * 없거나 마이그레이션 전이면 서비스 코드가 하드코딩된 기본값으로 폴백한다.
 */
model GachaConfig {
  id                     Int      @id @default(1)
  gachaRates             Json     @map("gacha_rates")
  normalEggRates         Json     @map("normal_egg_rates")
  bigEggRates            Json     @map("big_egg_rates")
  goldenEggRates         Json     @map("golden_egg_rates")
  pityRareThreshold      Int      @default(9) @map("pity_rare_threshold")
  pityLegendaryThreshold Int      @default(79) @map("pity_legendary_threshold")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("gacha_config")
}

model MaintenanceConfig {
  id        Int       @id @default(1)
  enabled   Boolean   @default(false)
  message   String?   @db.VarChar(500)
  endsAt    DateTime? @map("ends_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("maintenance_config")
}

/**
 * 캐릭터(케보몬) 마스터 데이터 — 관리자 페이지에서 편집.
 * id는 auto-increment가 아니라 기존 characterId 값 그대로 사용한다.
 * 행이 없는 캐릭터는 서비스 코드가 기존 하드코딩 기본값으로 폴백한다
 * (character-master.util.ts 참조) — 마이그레이션 직후에도 기존 밸런스와 동일하게 동작.
 */
model CharacterMaster {
  id             Int      @id
  type           String   @db.VarChar(20)
  rarity         String   @db.VarChar(12)
  arenaArchetype String   @map("arena_archetype") @db.VarChar(12)
  rogueArchetype String   @map("rogue_archetype") @db.VarChar(12)
  hpMult         Float    @default(1) @map("hp_mult")
  atkMult        Float    @default(1) @map("atk_mult")
  defMult        Float    @default(1) @map("def_mult")
  spdMult        Float    @default(1) @map("spd_mult")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("character_master")
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String                  @unique
  passwordHash           String?                 @map("password_hash")
  role                   String                  @default("USER")
  status                 String                  @default("ACTIVE") @db.VarChar(12)
  suspendedReason        String?                 @map("suspended_reason") @db.VarChar(255)
  suspendedUntil         DateTime?               @map("suspended_until")
  baseCountryCode        String                  @map("base_country_code") @db.Char(2)
  baseCurrency           CurrencyCode            @map("base_currency")
  profilePhoto           String?                 @map("profile_photo") @db.LongText
  hasPassword            Boolean                 @default(false) @map("has_password")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  lastLoginAt            DateTime?               @map("last_login_at")
  settings               AppSetting?
  posts                  CommunityPost[]
  comments               Comment[]
  reward                 UserReward?
  characters             UserCharacter[]
  titles                 UserTitle[]
  borders                UserBorder[]
  identities             UserIdentity[]
  postLikes              PostLike[]
  passwordChangeHistory  PasswordChangeHistory?
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  battleStats            BattleStats?
  duelStats              DuelStats?
  expedition             Expedition?
  arenaDecks             ArenaDeck[]
  attacksGiven           ArenaAttackLog[]        @relation("Attacker")
  attacksReceived        ArenaAttackLog[]        @relation("Defender")
  ownedGuild             Guild?
  guildMembership        GuildMember?
  guildApplications      GuildApplication[]
  guildBossContributions GuildBossContribution[]
  reports                Report[]

  @@map("users")
}

model PushSubscription {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  endpoint  String   @db.Text
  p256dh    String   @map("p256dh") @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  type      String   @db.VarChar(20) // "comment" | "achievement" | "title"
  title     String   @db.VarChar(120)
  body      String   @db.VarChar(255)
  titleKey  String?  @map("title_key") @db.VarChar(80)
  bodyKey   String?  @map("body_key") @db.VarChar(80)
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model UserIdentity {
  id             BigInt       @id @default(autoincrement())
  userId         String       @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  providerEmail  String?      @map("provider_email")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

model UserReward {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  missionPoints       Int       @default(0) @map("mission_points")
  attendanceDays      Int       @default(0) @map("attendance_days")
  streakDays          Int       @default(0) @map("streak_days")
  equippedCharacterId Int?      @map("equipped_character_id")
  equippedTitleId     Int?      @map("equipped_title_id")
  equippedBorderId    String?   @map("equipped_border_id") @db.VarChar(32)
  gachaPityCount      Int       @default(0) @map("gacha_pity_count")
  legendaryPityCount  Int       @default(0) @map("legendary_pity_count")
  totalPointsUsed     Int       @default(0) @map("total_points_used")
  normalEggs          Int       @default(0) @map("normal_eggs")
  bigEggs             Int       @default(0) @map("big_eggs")
  goldenEggs          Int       @default(0) @map("golden_eggs")
  enhancementStones   Int       @default(0) @map("enhancement_stones")
  raidCount           Int       @default(0) @map("raid_count")
  liveCount           Int       @default(0) @map("live_count")
  expeditionCount     Int       @default(0) @map("expedition_count")
  rogueClears         Int       @default(0) @map("rogue_clears")
  challengeBest       Int       @default(0) @map("challenge_best")
  dexMilestoneBest    Int       @default(0) @map("dex_milestone_best")
  arenaTickets        Int       @default(5) @map("arena_tickets")
  arenaTicketRegenAt  DateTime? @map("arena_ticket_regen_at")
  arenaTicketDate     String?   @map("arena_ticket_date") @db.VarChar(10)
  activeRunStartedAt  DateTime? @map("active_run_started_at")
  lastAttendanceDate  String?   @map("last_attendance_date") @db.VarChar(10)
  monthKey            String?   @map("month_key") @db.VarChar(7)
  monthDays           Int       @default(0) @map("month_days")
  monthWeekRewards    Int       @default(0) @map("month_week_rewards")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rewards")
}

model UserTitle {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id")
  titleId    Int      @map("title_id")
  obtainedAt DateTime @default(now()) @map("obtained_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@index([userId])
  @@map("user_titles")
}

model UserBorder {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id")
  borderId   String   @map("border_id") @db.VarChar(32)
  obtainedAt DateTime @default(now()) @map("obtained_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, borderId])
  @@index([userId])
  @@map("user_borders")
}

model UserCharacter {
  id               BigInt   @id @default(autoincrement())
  userId           String   @map("user_id")
  characterId      Int      @map("character_id")
  enhancementLevel Int      @default(0) @map("enhancement_level")
  obtainedAt       DateTime @default(now()) @map("obtained_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
  @@map("user_characters")
}

/**
 * 배틀 티어/전적
 */
model BattleStats {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  tierPoints Int      @default(0) @map("tier_points")
  wins       Int      @default(0)
  losses     Int      @default(0)
  winStreak  Int      @default(0) @map("win_streak")
  bestStreak Int      @default(0) @map("best_streak")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("battle_stats")
}

/**
 * 듀얼(1:1 카드 대전) 전적
 */
model DuelStats {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  wins       Int      @default(0)
  losses     Int      @default(0)
  winStreak  Int      @default(0) @map("win_streak")
  bestStreak Int      @default(0) @map("best_streak")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("duel_stats")
}

/**
 * 원정 (진행 중인 것 1건만 유지 — 완료 시 row 삭제)
 */
model Expedition {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  regionId        String   @map("region_id") @db.VarChar(20)
  partyIds        Json     @map("party_ids")
  startTime       DateTime @map("start_time")
  durationHours   Int      @map("duration_hours")
  eventTemplateId String?  @map("event_template_id") @db.VarChar(20)
  eventBonusMult  Float?   @map("event_bonus_mult")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expeditions")
}

/**
 * 아레나 공격/방어 덱
 */
model ArenaDeck {
  userId    String   @map("user_id")
  deckType  String   @map("deck_type") @db.VarChar(10)
  slots     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, deckType])
  @@map("arena_decks")
}

/**
 * 아레나 공격 로그 (복수 시스템)
 */
model ArenaAttackLog {
  id                  BigInt   @id @default(autoincrement())
  attackerId          String   @map("attacker_id")
  defenderId          String   @map("defender_id")
  attackerWon         Boolean  @map("attacker_won")
  pointsDelta         Int      @default(0) @map("points_delta")
  defenderPointsDelta Int      @default(0) @map("defender_points_delta")
  log                 Json?    @map("log")
  attackerChars       Json?    @map("attacker_chars")
  defenderChars       Json?    @map("defender_chars")
  createdAt           DateTime @default(now()) @map("created_at")
  attacker            User     @relation("Attacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender            User     @relation("Defender", fields: [defenderId], references: [id], onDelete: Cascade)

  @@index([defenderId, createdAt(sort: Desc)])
  @@index([attackerId, createdAt(sort: Desc)])
  @@map("arena_attack_logs")
}

/**
 * 길드
 */
model Guild {
  id           String             @id @default(uuid())
  name         String             @unique @db.VarChar(20)
  iconId       String             @default("default") @map("icon_id") @db.VarChar(32)
  notice       String?            @db.VarChar(200)
  level        Int                @default(1)
  exp          Int                @default(0)
  ownerId      String             @unique @map("owner_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members      GuildMember[]
  applications GuildApplication[]
  bossRuns     GuildBossRun[]
  posts        CommunityPost[]

  @@map("guilds")
}

/**
 * 길드원 — 유저는 동시에 한 길드에만 소속 (userId unique)
 */
model GuildMember {
  id                   BigInt   @id @default(autoincrement())
  guildId              String   @map("guild_id")
  userId               String   @unique @map("user_id")
  role                 String   @default("member") @map("role") @db.VarChar(10) // "owner" | "officer" | "member"
  totalContribution    Int      @default(0) @map("total_contribution")
  dailyBossAttacks     Int      @default(0) @map("daily_boss_attacks")
  dailyBossAttacksDate String?  @map("daily_boss_attacks_date") @db.VarChar(10)
  joinedAt             DateTime @default(now()) @map("joined_at")
  guild                Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("guild_members")
}

/**
 * 가입 신청 (승인제) — 길드장/부길드장이 승인·거절
 */
model GuildApplication {
  id        BigInt   @id @default(autoincrement())
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  message   String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([userId])
  @@map("guild_applications")
}

/**
 * 길드 주간 보스전 — 길드당 주 1건, 길드원 전체가 공유하는 HP 풀 (매주 리셋)
 */
model GuildBossRun {
  id             String                  @id @default(uuid())
  guildId        String                  @map("guild_id")
  weekKey        String                  @map("week_key") @db.VarChar(8) // "YYYY-Www" (KST 기준)
  bossId         Int                     @map("boss_id")
  maxHp          Int                     @map("max_hp")
  hpRemaining    Int                     @map("hp_remaining")
  clearedAt      DateTime?               @map("cleared_at")
  rewardsGranted Boolean                 @default(false) @map("rewards_granted")
  createdAt      DateTime                @default(now()) @map("created_at")
  guild          Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  contributions  GuildBossContribution[]

  @@unique([guildId, weekKey])
  @@index([rewardsGranted])
  @@map("guild_boss_runs")
}

/**
 * 유저별 이번 주 길드 보스 누적 데미지 (기여도 랭킹/보상 정산용 — 타격마다 increment)
 */
model GuildBossContribution {
  id        BigInt       @id @default(autoincrement())
  runId     String       @map("run_id")
  userId    String       @map("user_id")
  damage    Int          @default(0)
  updatedAt DateTime     @updatedAt @map("updated_at")
  run       GuildBossRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@map("guild_boss_contributions")
}

model AppSetting {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  notifications Boolean  @default(true)
  darkMode      Boolean  @default(true) @map("dark_mode")
  themeColor    String   @default("emerald") @map("theme_color") @db.VarChar(20)
  language      String   @default("ko") @db.VarChar(5)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_settings")
}

enum PostCategory {
  brag
  tip
  chat
}

model CommunityPost {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  content    String       @db.LongText
  category   PostCategory @default(chat)
  imageUrl   String?      @map("image_url") @db.LongText
  guildId    String?      @map("guild_id")
  likesCount Int          @default(0) @map("likes_count")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild      Guild?       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  likes      PostLike[]
  comments   Comment[]

  @@index([guildId, createdAt(sort: Desc)])
  @@map("community_posts")
}

model PostLike {
  id        BigInt        @id @default(autoincrement())
  postId    String        @map("post_id")
  userId    String        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id        BigInt        @id @default(autoincrement())
  postId    String        @map("post_id")
  userId    String        @map("user_id")
  parentId  BigInt?       @map("parent_id")
  content   String        @db.Text
  imageUrl  String?       @map("image_url") @db.LongText
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Report {
  id         String    @id @default(uuid())
  reporterId String    @map("reporter_id")
  targetType String    @map("target_type") @db.VarChar(20) // POST | COMMENT | USER
  targetId   String    @map("target_id")
  reason     String    @db.VarChar(500)
  status     String    @default("PENDING") @db.VarChar(20) // PENDING | RESOLVED | DISMISSED
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@map("reports")
}

model PasswordChangeHistory {
  id        BigInt   @id @default(autoincrement())
  userId    String   @unique @map("user_id")
  changedAt DateTime @default(now()) @map("changed_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_change_history")
}

enum VerificationPurpose {
  SIGNUP
  RESET_PASSWORD
}

model EmailVerificationCode {
  id        BigInt              @id @default(autoincrement())
  email     String              @db.VarChar(190)
  code      String              @db.Char(6)
  purpose   VerificationPurpose
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_verification_codes")
}
